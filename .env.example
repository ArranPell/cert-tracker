# Copy to .env and fill in. Never commit .env.

# Long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The address people use to reach the app. Used for sign-in redirects and links in emails.
BASE_URL=https://certs.corp.example.ca
# Set to true when a reverse proxy (IIS, nginx, Caddy) terminates TLS in front of the app.
TRUST_PROXY=true

TZ=America/St_Johns

# --- Sign-in (Microsoft Entra ID) -----------------------------------------------
AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional. Prefer "Assignment required" on the enterprise app instead (see README).
ENTRA_ALLOWED_GROUP_ID=

# --- Email ---------------------------------------------------------------------
SMTP_HOST=smtp-relay.corp.example.ca
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=cert-tracker@corp.example.ca
# A distribution list or shared mailbox, not a person. Comma-separate several.
DIGEST_TO=it-certificates@corp.example.ca

# --- Schedule and alerts -------------------------------------------------------
ALERT_THRESHOLDS=60,30,14,7
DAILY_RUN_TIME=06:30
# 0 = Monday
SUMMARY_WEEKDAY=0
SCAN_TIMEOUT=8
CT_ENABLED=true

# --- AD CS import --------------------------------------------------------------
# Bearer token the CA's scheduled task uses to post to /api/import/adcs.
API_TOKEN=
